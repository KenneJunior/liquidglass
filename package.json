{
  "name": "@kennejunior/liquidglass",
  "version": "1.0.1",
  "description": "Lightweight UI library built with TypeScript and Vite.",
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "@kennejunior/liquidglass",
    "liquidglass",
    "ui",
    "components",
    "typescript",
    "vite",
    "web",
    "design-system"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsup src/index.ts --format cjs,esm --dts --out-dir dist --clean",
    "preview": "vite preview",
    "prepare": "npm run build:lib",
    "test": "echo \"No tests Available\" && exit 0"
  },
  "dependencies": {
    "detect-libc": "^2.1.2",
    "fdir": "^6.5.0",
    "lightningcss": "^1.32.0",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "nanoid": "^3.3.15",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.16",
    "rolldown": "^1.1.3",
    "source-map-js": "^1.2.1",
    "tinyglobby": "^0.2.17"
  },
  "author": "KenneJunior",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/KenneJunior/liquidglass/issues"
  },
  "homepage": "https://github.com/KenneJunior/liquidglass#readme",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KenneJunior/liquidglass.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "dist/index.js"
}
